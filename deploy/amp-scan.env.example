# Use a non-identifying randomly generated ID.
NODE_ID=unconfigured
DB_PATH=/var/lib/amp-scan/telemetry.db
RETENTION_DAYS=14
MAX_PENDING=50000
MAX_SAMPLES_PER_RUN=10000
REPORT_BATCH_SIZE=50
# Separate operator-owned telemetry receiver, NOT an assumed RFbeta API.
REPORT_URL=
REPORT_TOKEN_FILE=/etc/amp-scan/report.token
# Optional, reviewed absolute-path executable emitting frequency_hz,power_dbm rows.
SPECTRUM_COMMAND=
