# Use a randomly generated non-identifying node ID.
NODE_ID=unconfigured
DB_PATH=/var/lib/amp-scan/telemetry.db
RETENTION_DAYS=14
MAX_PENDING=50000
REPORT_BATCH_SIZE=50
# Off by default: 'rtl_power' for RTL-SDR or 'custom' for two-column CSV.
SPECTRUM_MODE=off
RTL_POWER_PATH=/usr/bin/rtl_power
RTL_POWER_RANGES=88M:108M:125k
RTL_POWER_INTERVAL_SECONDS=10
SWEEP_TIMEOUT_SECONDS=40
MAX_SAMPLES_PER_RUN=10000
SPECTRUM_BIN_HZ=1000000
MAX_REPORT_BINS=256
SPECTRUM_COMMAND=
# Optional private telemetry API, not SparrowMap's RFbeta endpoint.
REPORT_URL=
REPORT_TOKEN_FILE=/etc/amp-scan/report.token
